# Virtual Environment
venv/
.venv/
env/
ENV/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Large raw datasets (>100MB, excluded from GitHub)
data/raw/**
!data/raw/**/.gitkeep
!data/raw/**/*.xml
!data/raw/**/*.LBL

# Large binary archives & model weights if any
*.tar
*.zip
*.gz
*.7z
